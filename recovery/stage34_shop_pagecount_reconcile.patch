@@ -133,8 +133,12 @@
 	if len(items) == 0 {
 		return nil, 0, 0, fmt.Errorf("shop catalog %s section %q has no items", path, shopID)
 	}
-	if pageCount == 0 {
-		pageCount = maxPageKey + 1
+	// PageInfo can underdeclare an authored numeric page (the exact RAR has
