+name: Stage37 shop sparse wallet disposable MySQL regression
+on:
+  push:
+    branches: [stage37-restored-20260918]
+    paths:
+      - 'server/internal/shopbuyatomic/**'
+      - '.github/workflows/stage37-shop-sparse-wallet-db-ci.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  sparse-wallet-db:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    services:
+      mysql:
+        image: mysql:8.4
+        env:
+          MYSQL_ROOT_PASSWORD: shopci_root_only
+          MYSQL_DATABASE: shop_atomic_ci
+          MYSQL_USER: shopci
+          MYSQL_PASSWORD: shopci_pw
+        ports: ['3306:3306']
+        options: >-
+          --health-cmd="mysqladmin ping -h localhost -u root -pshopci_root_only"
+          --health-interval=5s --health-timeout=5s --health-retries=30
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-go@v5
+        with:
+          go-version: '1.26.5'
+          cache: false
+      - name: Run purchase regression only against disposable shop_atomic_ci
+        working-directory: server
+        shell: bash
+        env:
+          JIUYIN_TEST_SHOP_MYSQL_CI: '1'
+          JIUYIN_TEST_SHOP_MYSQL_DSN: 'shopci:shopci_pw@tcp(127.0.0.1:3306)/shop_atomic_ci?parseTime=true'
+        run: |
+          set -euo pipefail
+          cp go.mod ci.real.mod
+          cp go.sum ci.real.sum
+          for path in github.com/go-sql-driver/mysql golang.org/x/text filippo.io/edwards25519 github.com/DATA-DOG/go-sqlmock github.com/Hiroko103/go-quicklz; do
+            go mod edit -modfile=ci.real.mod -dropreplace="$path"
+          done
+          go mod edit -modfile=ci.real.mod -require=github.com/Hiroko103/go-quicklz@v0.0.0-20190115215310-59904abc50d0
+          go mod tidy -modfile=ci.real.mod
+          test -z "$(gofmt -l internal/shopbuyatomic/checked.go internal/shopbuyatomic/checked_wallet_legacy_zero_test.go internal/shopbuyatomic/checked_mysql_integration_test.go)"
+          go test -modfile=ci.real.mod -count=1 -v ./internal/shopbuyatomic
+          echo 'DISPOSABLE_MYSQL_SPARSE_WALLET=PASS USER_PC_MYSQL=NOT_RUN LIVE_E2E=NOT_RUN'
